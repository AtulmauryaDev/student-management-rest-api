{
  "info": {
    "name": "Student Management REST API",
    "description": "Postman requests for CRUD, pagination, sorting, validation, and name search.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "studentId",
      "value": "3"
    }
  ],
  "item": [
    {
      "name": "Create student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Kumar\",\n  \"email\": \"rahul@example.com\",\n  \"course\": \"MCA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
    {
      "name": "Get students (pagination)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students?page=0&size=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "5"
            }
          ]
        }
      }
    },
    {
      "name": "Sort students by name",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students?page=0&size=5&sortBy=name&direction=asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "5"
            },
            {
              "key": "sortBy",
              "value": "name"
            },
            {
              "key": "direction",
              "value": "asc"
            }
          ]
        }
      }
    },
    {
      "name": "Search students by partial name",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students/search?name=Rah&page=0&size=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "search"
          ],
          "query": [
            {
              "key": "name",
              "value": "Rah"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "5"
            }
          ]
        }
      }
    },
    {
      "name": "Search (case-insensitive)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students/search?name=rahul",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "search"
          ],
          "query": [
            {
              "key": "name",
              "value": "rahul"
            }
          ]
        }
      }
    },
    {
      "name": "Get student by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      }
    },
    {
      "name": "Update student",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Kumar Updated\",\n  \"email\": \"rahul.updated@example.com\",\n  \"course\": \"MCA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      }
    },
    {
      "name": "Invalid request (validation demo)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"course\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
    {
      "name": "Invalid pagination (expected 400)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students?page=-1&size=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ],
          "query": [
            {
              "key": "page",
              "value": "-1"
            },
            {
              "key": "size",
              "value": "5"
            }
          ]
        }
      }
    },
    {
      "name": "Delete student",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      }
    }
  ]
}